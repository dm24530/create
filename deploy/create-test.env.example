# Local test environment for deploy/docker-compose.test.yml.
# Copy this file to create-test.env and replace every CHANGE_ME value.
# Never commit create-test.env or real secrets.
#
# For an existing local database, preserve its current JWT_SECRET and
# TOTP_ENCRYPTION_KEY. Changing them invalidates encrypted settings.
#
# Generate a 64-hex secret on Windows PowerShell:
#   $b=[Security.Cryptography.RandomNumberGenerator]::GetBytes(32)
#   [Convert]::ToHexString($b).ToLowerInvariant()

# PostgreSQL container bootstrap
POSTGRES_USER=create
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=create

# Application bootstrap
AUTO_SETUP=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=production
RUN_MODE=standard
TZ=Asia/Shanghai

# PostgreSQL connection used by the application
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=create
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_DBNAME=create
DATABASE_SSLMODE=disable

# Redis connection used by the application
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Initial admin created by AUTO_SETUP on a fresh database only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Stable security keys
# Keep these values across restarts and database restores.
JWT_SECRET=CHANGE_ME_64_HEX
TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX

# Do not put S3 credentials here.
# Configure backup S3 and image storage in the application admin settings.
#
# Compose-only values such as CREATE_TEST_IMAGE and CREATE_TEST_PORT are not
# application environment variables. Set them in the shell or deploy/.env.
