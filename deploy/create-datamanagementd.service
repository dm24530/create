[Unit]
Description=Create Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=create
Group=create
WorkingDirectory=/opt/create
ExecStart=/opt/create/datamanagementd \
  -socket-path /tmp/create-datamanagement.sock \
  -sqlite-path /var/lib/create/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
