{
  "name": "create-canvas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Create Canvas standalone desktop application",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/security.js && npm test",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "test:smoke": "node test/smoke.js"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.56.0"
  },
  "build": {
    "appId": "com.create.canvas",
    "productName": "Create Canvas",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist-desktop",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    }
  },
  "author": "Create"
}
