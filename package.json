{
  "name": "create-app",
  "version": "0.1.18",
  "private": true,
  "description": "Standalone Create desktop application",
  "main": "desktop/src/main.js",
  "scripts": {
    "start": "npm --prefix desktop start",
    "check": "npm --prefix web run typecheck && npm --prefix desktop run check",
    "test": "npm --prefix web test && npm --prefix desktop run check",
    "build": "npm --prefix web run build:desktop",
    "build:desktop": "npm --prefix web run build:desktop",
    "pack:local": "npm --prefix desktop run dist:dir:local"
  },
  "engines": {
    "node": ">=24"
  }
}
